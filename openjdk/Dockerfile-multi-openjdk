ARG BASE_IMAGE=ubuntu:26.04
FROM ${BASE_IMAGE}

ARG MAVEN_VERSION=3.9.16
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6

ENV DEBIAN_FRONTEND=noninteractive \
    JAVA_HOME=/opt/java/openjdk-17 \
    MAVEN_HOME=/opt/maven \
    MAVEN_CONFIG=/root/.m2
ENV PATH="${MAVEN_HOME}/bin:${JAVA_HOME}/bin:${PATH}"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash \
        vim \
        curl \
        wget \
        ca-certificates \
        iputils-ping \
        telnet \
        ftp \
        net-tools \
        iproute2 \
        procps \
        xz-utils \
        unzip \
        zip \
        bzip2 \
        file \
        openjdk-8-jdk-headless \
        openjdk-17-jdk-headless \
        openjdk-25-jdk-headless; \
    mkdir -p /opt/java; \
    for version in 8 17 25; do \
        jdk_home="$(dpkg-query -L "openjdk-${version}-jdk-headless" | sed -n 's#/bin/javac$##p' | head -n 1)"; \
        test -n "${jdk_home}"; \
        ln -s "${jdk_home}" "/opt/java/openjdk-${version}"; \
    done; \
    jdk17_home="$(readlink -f /opt/java/openjdk-17)"; \
    for executable in "${jdk17_home}"/bin/*; do \
        command_name="${executable##*/}"; \
        if update-alternatives --list "${command_name}" 2>/dev/null | grep -Fqx "${executable}"; then \
            update-alternatives --set "${command_name}" "${executable}"; \
        fi; \
    done; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    maven_archive="apache-maven-${MAVEN_VERSION}-bin.tar.gz"; \
    curl -fsSL \
        "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/${maven_archive}" \
        -o "/tmp/${maven_archive}"; \
    echo "${MAVEN_SHA512}  /tmp/${maven_archive}" | sha512sum -c -; \
    tar -xzf "/tmp/${maven_archive}" -C /opt; \
    ln -s "/opt/apache-maven-${MAVEN_VERSION}" "${MAVEN_HOME}"; \
    rm -f "/tmp/${maven_archive}"; \
    mkdir -p "${MAVEN_CONFIG}"; \
    printf '%s\n' \
        '<?xml version="1.0" encoding="UTF-8"?>' \
        '<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0"' \
        '            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"' \
        '            xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 https://maven.apache.org/xsd/toolchains-1.1.0.xsd">' \
        '  <toolchain>' \
        '    <type>jdk</type>' \
        '    <provides>' \
        '      <version>8</version>' \
        '      <vendor>openjdk</vendor>' \
        '    </provides>' \
        '    <configuration>' \
        '      <jdkHome>/opt/java/openjdk-8</jdkHome>' \
        '    </configuration>' \
        '  </toolchain>' \
        '  <toolchain>' \
        '    <type>jdk</type>' \
        '    <provides>' \
        '      <version>17</version>' \
        '      <vendor>openjdk</vendor>' \
        '    </provides>' \
        '    <configuration>' \
        '      <jdkHome>/opt/java/openjdk-17</jdkHome>' \
        '    </configuration>' \
        '  </toolchain>' \
        '  <toolchain>' \
        '    <type>jdk</type>' \
        '    <provides>' \
        '      <version>25</version>' \
        '      <vendor>openjdk</vendor>' \
        '    </provides>' \
        '    <configuration>' \
        '      <jdkHome>/opt/java/openjdk-25</jdkHome>' \
        '    </configuration>' \
        '  </toolchain>' \
        '</toolchains>' \
        > "${MAVEN_CONFIG}/toolchains.xml"; \
    java -version; \
    javac -version; \
    mvn -version

CMD ["/bin/bash"]
